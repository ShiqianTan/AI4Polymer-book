.DS_Store
__pycache__/
*.pyc
tmp/pdfs/

# Generated website and local legacy previews are never source files.
/build/
/book/build/
/.mkdocs-build.yml
.venv-site/
*.html
*.htm

# Local editor state, caches, credentials and disposable previews.
/.obsidian/
/.ruff_cache/
/.pytest_cache/
/tmp/
/output/
.venv/
.env
.env.*
!.env.example

# LaTeX and Pandoc intermediates. The book PDF builds into book/build/, so these
# are disposable.
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lof
*.lot
*.bbl
*.blg
*.idx
*.ind
*.ilg
*.nav
*.snm
*.vrb

# Build logs. New logs that are meant to be kept need `git add -f`.
*.log
